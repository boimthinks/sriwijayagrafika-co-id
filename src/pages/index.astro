          style="width: 100%; height: auto;"
        />
        <div class="carousel-caption">
          <h3>Sriwijaya grafika</h3>
          <p>Sriwijaya Grafika - pilihan tepat untuk usaha anda</p>
          <a href="tel:085100888748">Hubungi kami</a>
        </div>
      </div>
    </div>
  </div>

